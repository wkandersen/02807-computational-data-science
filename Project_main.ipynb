   "source": [
    "# Helper functions\n",
    "def support_of_item_in_baskets(item, baskets):\n",
    "    if not baskets:\n",
    "        return 0.0\n",
    "    return sum(1 for b in baskets if item in b) / len(baskets)\n",
    "\n",
    "def support_of_pair_in_baskets(pair, baskets):\n",
    "    a, b = pair\n",
    "    if not baskets:\n",
    "        return 0.0\n",
    "    return sum(1 for s in baskets if a in s and b in s) / len(baskets)\n",
    "\n",
    "def support_of_triples_in_baskets(triple, baskets):\n",
    "    a, b, c = triple\n",
    "    if not baskets:\n",
    "        return 0.0\n",
    "    return sum(1 for s in baskets if a in s and b in s and c in s) / len(baskets)"
   ]

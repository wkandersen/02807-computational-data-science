   "source": [
    "### extract frequent pairs that exceed support_freq_pairs s2 (assume s2 = 0.02), and hash back.\n",
    "\n",
    "support_freq_pairs = 0.1\n",
    "\n",
    "freq_pairs = [[df_freq_item_hash[df_freq_item_hash['hashcode']==x].index[0], df_freq_item_hash[df_freq_item_hash['hashcode']==y].index[0]] for x, y in zip(*np.where(pair_mat_hashed > support_freq_pairs*len(baskets)))]"
   ]

   "source": [
    "# Simple approach: Find biggest drop in support distribution for each community using df_comm_pair_support_Spectral\n",
    "print(\"Finding biggest drop in support distribution for each community...\")\n",
    "\n",
    "for comm_idx in df_comm_pair_support_Spectral['community'].unique():\n",
    "    # Filter data for this community\n",
    "    comm_data = df_comm_pair_support_Spectral[df_comm_pair_support_Spectral['community'] == comm_idx].copy()\n",
    "    \n",
    "    n_songs = comm_data['n_songs'].iloc[0]  # Number of songs in community\n",
    "    print(f\"\\nCommunity {comm_idx} ({n_songs} songs):\")\n",
    "    \n",
    "    # Get support values and sort them high to low\n",
    "    pair_supports = sorted(comm_data['support'].values, reverse=True)\n",
    "    \n",
    "    if len(pair_supports) < 2:\n",
    "        print(\"  Not enough pairs to analyze\")\n",
    "        continue\n",
    "    \n",
    "    # Find biggest drop\n",
    "    drops = [pair_supports[i] - pair_supports[i+1] for i in range(len(pair_supports)-1)]\n",
    "    biggest_drop_idx = np.argmax(drops)\n",
    "    optimal_threshold = pair_supports[biggest_drop_idx + 1]  # After the drop\n",
    "    \n",
    "    print(f\"  Biggest drop: {drops[biggest_drop_idx]:.3f} at support {pair_supports[biggest_drop_idx]:.3f}\")\n",
    "    print(f\"  Optimal threshold: {optimal_threshold:.3f}\")\n",
    "    \n",
    "    # Show how many pairs this gives us\n",
    "    frequent_pairs = comm_data[comm_data['support'] >= optimal_threshold]\n",
    "    print(f\"  Frequent pairs: {len(frequent_pairs)}\")\n",
    "    \n",
    "    # Show top 3\n",
    "    top_pairs = frequent_pairs.nlargest(3, 'support')\n",
    "    print(\"  Top pairs:\")\n",
    "    for _, row in top_pairs.iterrows():\n",
    "        print(f\"    {row['item']}: {row['support']:.3f}\")"
   ]
  }

    "# Community-level support: aggregate genre baskets into communities and compute top items/pairs\n",
    "# Map genre -> community index\n",
    "genre_to_comm = {}\n",
    "for idx, comm in enumerate(louvainC):\n",
    "    for g in comm:\n",
    "        genre_to_comm[g] = idx\n",
    "\n",
    "# Aggregate per-genre baskets into communities (deduplicate baskets using frozenset)\n",
    "community_baskets = defaultdict(list)\n",
    "for genre, baskets in genre_song_baskets.items():\n",
    "    comm_idx = genre_to_comm.get(genre, None)\n",
    "    if comm_idx is None:\n",
    "        continue\n",
    "    # add all baskets for this genre to the community\n",
    "    community_baskets[comm_idx].extend(baskets)\n",
    "\n",
    "# Deduplicate exact baskets (same song appearing in multiple genres in same community)\n",
    "for k in list(community_baskets.keys()):\n",
    "    uniq = {frozenset(b) for b in community_baskets[k]}\n",
    "    community_baskets[k] = [set(x) for x in uniq]\n",
    "\n",
    "print('Community-level top pairs (support within community):')\n",
    "comm_rows = []\n",
    "comm_rows_pair_Louvain = []\n",
    "for comm_idx, baskets in sorted(community_baskets.items(), key=lambda x: -len(x[1])):\n",
    "    n_songs = len(baskets)\n",
    "    if n_songs == 0:\n",
    "        continue\n",
    "    \n",
    "    pair_supports = [(tuple(p), support_of_pair_in_baskets(p, baskets)) for p in pairs]\n",
    "    pair_supports = sorted(pair_supports, key=lambda x: -x[1])\n",
    "    top_pairs = [(p, sup) for p, sup in pair_supports if sup >= MIN_SUPPORT][:TOP_K]\n",
    "\n",
    "\n",
    "    # print summary\n",
    "    comm_genres = sorted(list(louvainC[comm_idx]))\n",
    "    print('\\nCommunity', comm_idx, f'(n_songs={n_songs}) — genres =', comm_genres)\n",
    "\n",
    "    if top_pairs:\n",
    "        print('  Top pairs:')\n",
    "        for (a,b), sup in top_pairs:\n",
    "            print(f\"    ({a}, {b}): support={sup:.2f}\")\n",
    "    else:\n",
    "        print('  Top pairs: none above threshold')\n",
    "\n",
    "    for it, sup in pair_supports:\n",
    "        comm_rows_pair_Louvain.append({'community': comm_idx, 'genres': ','.join(comm_genres), 'item': f'({it[0]},{it[1]})', 'support': sup, 'n_songs': n_songs})   \n",
    "\n",
    "df_comm_pair_support_Louvaine = pd.DataFrame(comm_rows_pair_Louvain)\n",
    "\n",
    "# Example: top 12 community-item combinations\n",
    "display(df_comm_pair_support_Louvaine.sort_values(['support','n_songs'], ascending=[False, False]).head(12))\n"

   "source": [
    "# Create baskets of emotion-lexicon words per genre (from df_expanded['genre','lyrics'])\n",
    "extract_stopwords = []\n",
    "\n",
    "# Build stopword set: try NLTK then fallback to a small built-in list\n",
    "try:\n",
    "    import nltk\n",
    "    from nltk.corpus import stopwords\n",
    "    try:\n",
    "        STOPWORDS = set(stopwords.words('english'))\n",
    "    except LookupError:\n",
    "        nltk.download('stopwords', quiet=True)\n",
    "        STOPWORDS = set(stopwords.words('english'))\n",
    "except Exception:\n",
    "    STOPWORDS = {\n",
    "        'the','and','a','an','in','on','of','to','is','it','you','i','me','my','we','us',\n",
    "        'that','this','for','with','are','was','be','as','at','by','from','or','not','but',\n",
    "        'have','has','had','he','she','they','them','his','her','its','so','if','then', \"i'm\",\n",
    "        'oh','yeah','la','na','woah','uh','ah'\n",
    "    }\n",
    "\n",
    "STOPWORDS.update(extract_stopwords)\n",
    "# Build emotion-word set (only association==1)\n",
    "EMO_WORDS = set(df_emo.loc[df_emo['association'] == 1, 'word'].astype(str).str.lower())\n",
    "\n",
    "def tokenize(text):\n",
    "    if not isinstance(text, str):\n",
    "        return []\n",
    "    # keep contractions and alphanumerics; return lowercase tokens\n",
    "    return re.findall(r\"\\b[\\w']+\\b\", text.lower())\n",
    "\n",
    "def filter_tokens(tokens):\n",
    "    out = []\n",
    "    for t in tokens:\n",
    "        # drop stopwords, very short tokens and purely numeric tokens\n",
    "        if t in STOPWORDS:\n",
    "            continue\n",
    "        if len(t) < 2:\n",
    "            continue\n",
    "        if t.isnumeric():\n",
    "            continue\n",
    "        # keep only tokens present in the emotion lexicon\n",
    "        if t not in EMO_WORDS:\n",
    "            continue\n",
    "        out.append(t)\n",
    "    return out\n",
    "\n",
    "# Aggregate filtered emotion words per genre\n",
    "genre_words = defaultdict(list)\n",
    "for _, row in df_expanded[['genre','lyrics']].iterrows():\n",
    "    g = row['genre']\n",
    "    tokens = tokenize(row['lyrics'])\n",
    "    filt = filter_tokens(tokens)\n",
    "    genre_words[g].extend(filt)\n",
    "\n",
    "# Build Counters (word frequencies) and unique-word baskets\n",
    "genre_baskets_counts = {g: Counter(words) for g, words in genre_words.items()}\n",
    "genre_baskets_unique = {g: list(counter.keys()) for g, counter in genre_baskets_counts.items()}"
   ]
